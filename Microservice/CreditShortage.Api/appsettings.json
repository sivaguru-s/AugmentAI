{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "AshleyDatabase": "Server=AFIBatchSQLStage\\AFI_QBATCH;Database=Ashley;Integrated Security=true;",
    "DatawhseDatabase": "Server=AFIBatchSQLStage\\AFI_QBATCH;Database=Ashley;Integrated Security=true;",
    "ArchiveDatabase": "Server=AFIBatchSQLStage\\AFI_QBATCH;Database=Ashley;Integrated Security=true;"
  },
  "ShortageValidationSettings": {
    "DefaultDefectCode": "XP",
    "DefaultLocationCode": "WU",
    "DefaultEnvironment": "AFI",
    "MaxBatchSize": 500,
    "CommandTimeout": 60
  },
  "IWSIntegration": {
    "BaseUrl": "https://iws-api.ashley.com",
    "ApiKey": "YOUR_IWS_API_KEY",
    "Timeout": 30,
    "RetryCount": 3,
    "RetryDelaySeconds": 2
  },
  "AllowedHosts": "*"
}
