{
  "name": "epay",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/epay/src",
  "prefix": "epay",
  "targets": {
    "build": {
      "executor": "@angular-devkit/build-angular:browser",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/epay",
        "index": "apps/epay/src/index.html",
        "main": "apps/epay/src/main.ts",
        "polyfills": ["zone.js"],
        "tsConfig": "apps/epay/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          "apps/epay/src/favicon.ico",
          "apps/epay/src/assets"
        ],
        "styles": [
          "node_modules/bootstrap/dist/css/bootstrap.min.css",
          {
            "input": "apps/epay/src/styles.scss",
            "bundleName": "epay_module_styles",
            "inject": true
          }
        ],
        "scripts": []
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "2mb",
              "maximumError": "4mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "5kb",
              "maximumError": "7kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "buildOptimizer": false,
          "optimization": false,
          "vendorChunk": true,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@angular-devkit/build-angular:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "epay:build:production"
        },
        "development": {
          "buildTarget": "epay:build:development"
        }
      },
      "defaultConfiguration": "development",
      "options": {
        "port": 4200,
        "proxyConfig": "apps/epay/proxy.conf.json"
      }
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "epay:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@angular-devkit/build-angular:karma",
      "options": {
        "polyfills": ["zone.js", "zone.js/testing"],
        "tsConfig": "apps/epay/tsconfig.spec.json",
        "inlineStyleLanguage": "scss",
        "assets": ["apps/epay/src/favicon.ico", "apps/epay/src/assets"],
        "styles": ["apps/epay/src/styles.scss"],
        "scripts": []
      }
    }
  },
  "tags": []
}

