{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "AFI_Batch": "Server=YOUR_SQL_SERVER;Database=Datawhse;Integrated Security=true;TrustServerCertificate=true;",
    "DefaultConnection": "Server=YOUR_SQL_SERVER;Database=Datawhse;Integrated Security=true;TrustServerCertificate=true;",
    "AshleyDatabase": "Server=YOUR_SQL_SERVER;Database=Ashley;Integrated Security=true;TrustServerCertificate=true;"
  },
  "AppSettings": {
    "DefaultDateSpanInDays": 30,
    "MaxPageSize": 1000,
    "DefaultPageSize": 500
  }
}

