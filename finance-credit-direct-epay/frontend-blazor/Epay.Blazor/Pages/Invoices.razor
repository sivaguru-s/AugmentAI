@page "/invoices"
@using Epay.Blazor.Models
@inject Epay.Blazor.Services.InvoiceApiClient Api

<EditForm Model="criteria" OnValidSubmit="SearchAsync">
    <DataAnnotationsValidator />
    <div class="epay-panel">
        <div class="hdr">Search Invoices</div>
        <div class="body">
            <div class="row g-2 align-items-end">
                <div class="col-md-2">
                    <label>Customer #</label>
                    <InputText class="form-control" @bind-Value="criteria.CustomerNumber" />
                </div>
                <div class="col-md-2">
                    <label>Ship To</label>
                    <InputText class="form-control" @bind-Value="criteria.ShipToNumber" />
                    <div class="form-check mt-1">
                        <InputCheckbox class="form-check-input" @bind-Value="criteria.AllShipTos" />
                        <label class="form-check-label text-small">All Ship-Tos</label>
                    </div>
                </div>
                <div class="col-md-2">
                    <label>Invoice #</label>
                    <InputText class="form-control" @bind-Value="criteria.InvoiceNumber" />
                </div>
                <div class="col-md-2">
                    <label>Credit #</label>
                    <InputText class="form-control" @bind-Value="criteria.CreditNumber" />
                </div>
                <div class="col-md-2">
                    <label>PO #</label>
                    <InputText class="form-control" @bind-Value="criteria.PONumber" />
                </div>
                <div class="col-md-2">
                    <label>Invoice Date</label>
                    <div class="d-flex gap-1">
                        <InputDate class="form-control" @bind-Value="criteria.FromDate" />
                        <InputDate class="form-control" @bind-Value="criteria.ToDate" />
                    </div>
                </div>
                <div class="col-md-2">
                    <button class="btn btn-adr w-100" type="submit" disabled="@loading">Search</button>
                </div>
                <div class="col-md-3 d-flex align-items-center">
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" id="chkShowAll"
                               checked="@criteria.ShowAll"
                               @onchange="OnShowAllChanged" />
                        <label class="form-check-label text-small" for="chkShowAll">Show All Invoices</label>
                    </div>
                </div>
            </div>
        </div>
    </div>
</EditForm>

@if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger mt-3">@error</div>
}

@if (result is not null)
{
    <div class="d-flex justify-content-between align-items-center mt-3 mb-2">
        <div class="d-flex align-items-center gap-3">
            <span class="text-muted small">
                @if (criteria.ShowAll)
                {
                    <text>Showing all @result.Result.Items.Count records</text>
                }
                else
                {
                    <text>Showing @result.Result.Items.Count of @result.Result.TotalRecords records</text>
                }
            </span>
            @if (!criteria.ShowAll)
            {
                <div class="d-flex align-items-center gap-2">
                    <label class="small text-muted mb-0">Page Size:</label>
                    <select class="form-select form-select-sm" style="width: auto;"
                            value="@criteria.PageSize" @onchange="OnPageSizeChanged">
                        <option value="50">50</option>
                        <option value="100">100</option>
                        <option value="250">250</option>
                        <option value="500">500</option>
                    </select>
                </div>
            }
        </div>
        <div>
            <button class="btn btn-adr btn-sm me-2" disabled>Make Payment</button>
            <button class="btn btn-outline-secondary btn-sm" disabled>Export to Excel</button>
        </div>
    </div>

    @* Pagination Controls - matches VB.Net rptPager *@
    @if (!criteria.ShowAll && result.Result.TotalPages > 1)
    {
        <div class="pagination-container text-center mb-2">
            <nav aria-label="Invoice pagination">
                <ul class="pagination pagination-sm justify-content-center mb-0">
                    @* Previous button *@
                    <li class="page-item @(result.Result.HasPreviousPage ? "" : "disabled")">
                        <a class="page-link" href="javascript:void(0)" @onclick="() => GoToPage(criteria.PageNumber - 1)"
                           @onclick:preventDefault="true">Prev</a>
                    </li>

                    @* Page numbers *@
                    @foreach (var pageNum in GetPageNumbers())
                    {
                        <li class="page-item @(pageNum == criteria.PageNumber ? "active" : "")">
                            <a class="page-link" href="javascript:void(0)" @onclick="() => GoToPage(pageNum)"
                               @onclick:preventDefault="true">@pageNum</a>
                        </li>
                    }

                    @* Next button *@
                    <li class="page-item @(result.Result.HasNextPage ? "" : "disabled")">
                        <a class="page-link" href="javascript:void(0)" @onclick="() => GoToPage(criteria.PageNumber + 1)"
                           @onclick:preventDefault="true">Next</a>
                    </li>
                </ul>
            </nav>
        </div>
    }

    @if (result.Result.Items.Count == 0)
    {
        <div class="alert alert-info">No Data To Display</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm epay-grid align-middle">
                <thead>
                    <tr>
                        <th>Invoice #</th>
                        <th>Date</th>
                        <th class="text-end">Amount</th>
                        <th class="text-end">Paid</th>
                        <th class="text-end">Balance</th>
                        <th>PO #</th>
                        <th>Order #</th>
                        <th>Days</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var inv in result.Result.Items)
                {
                    <tr>
                        <td>@inv.InvoiceNumber</td>
                        <td>@inv.InvoiceDate.ToString("yyyy-MM-dd")</td>
                        <td class="text-end">@inv.InvoiceAmount.ToString("C")</td>
                        <td class="text-end">@inv.AmountPaid.ToString("C")</td>
                        <td class="text-end">@inv.Balance.ToString("C")</td>
                        <td>@inv.PONumber</td>
                        <td>@inv.OrderNumber</td>
                        <td>@inv.Days</td>
                        <td>@inv.EPayStatus</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
}

@code {
    private InvoiceSearchRequest criteria = new()
    {
        CustomerNumber = "4444400",
        ShipToNumber = string.Empty,
        AllShipTos = true,
        SecurityMHS = "MASTERXX",
        PageNumber = 1,
        PageSize = 500,
        SortAscending = true,
        SortColumn = null,
        ShowAll = false,
        FromDate = DateTime.Today.AddDays(-180),
        ToDate = DateTime.Today
    };

    private InvoiceSearchResponse? result;
    private bool loading;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var days = await Api.GetDefaultDateSpanAsync();
            criteria.FromDate = DateTime.Today.AddDays(-days);
            criteria.ToDate = DateTime.Today;
        }
        catch { /* use 180-day default if endpoint not reachable */ }
    }

    private async Task SearchAsync()
    {
        loading = true;
        error = null;
        result = null;
        try
        {
            result = await Api.SearchInvoicesAsync(criteria);
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    /// <summary>
    /// Handles the Show All Invoices checkbox change event.
    /// Mirrors VB.Net behavior: chkShowAllInvoices_CheckedChanged immediately triggers LoadGrid(0)
    /// </summary>
    private async Task OnShowAllChanged(ChangeEventArgs e)
    {
        // Toggle the ShowAll flag
        criteria.ShowAll = (bool)(e.Value ?? false);

        // When ShowAll is checked, set PageNumber to 0 (like VB.Net LoadGrid(0))
        // When unchecked, reset to page 1
        if (criteria.ShowAll)
        {
            criteria.PageNumber = 0;
            criteria.PageSize = 0;
        }
        else
        {
            criteria.PageNumber = 1;
            criteria.PageSize = 500;
        }

        // Trigger search immediately (matches VB.Net behavior)
        await SearchAsync();
    }

    /// <summary>
    /// Navigate to a specific page.
    /// Mirrors VB.Net Page_Changed event handler.
    /// </summary>
    private async Task GoToPage(int pageNumber)
    {
        if (result == null || pageNumber < 1 || pageNumber > result.Result.TotalPages)
            return;

        criteria.PageNumber = pageNumber;
        await SearchAsync();
    }

    /// <summary>
    /// Handle page size change from dropdown.
    /// Resets to page 1 when page size changes.
    /// </summary>
    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int newPageSize))
        {
            criteria.PageSize = newPageSize;
            criteria.PageNumber = 1; // Reset to first page
            await SearchAsync();
        }
    }

    /// <summary>
    /// Generate list of page numbers to display (max 10 pages).
    /// Mirrors VB.Net GridPaging.LoadPagerItems logic.
    /// </summary>
    private List<int> GetPageNumbers()
    {
        if (result == null) return new List<int>();

        var pages = new List<int>();
        var totalPages = result.Result.TotalPages;
        var currentPage = criteria.PageNumber;

        const int maxPages = 10;
        int startPage = Math.Max(1, currentPage - maxPages / 2);
        int endPage = Math.Min(totalPages, startPage + maxPages - 1);

        // Adjust start if we're near the end
        if (endPage - startPage < maxPages - 1)
        {
            startPage = Math.Max(1, endPage - maxPages + 1);
        }

        for (int i = startPage; i <= endPage; i++)
        {
            pages.Add(i);
        }

        return pages;
    }
}
