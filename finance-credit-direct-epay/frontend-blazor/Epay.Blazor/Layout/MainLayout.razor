                </ul>
            </section>
            <section>
                <h6>Customer Care</h6>
                <ul>
                    <li><a href="#">How to Join Ashley Express</a></li>
                    <li><a href="#">Forms</a></li>
                    <li><a href="#">Hope to Dream</a></li>
                    <li><a href="#">Ashley Furniture Industries</a></li>
