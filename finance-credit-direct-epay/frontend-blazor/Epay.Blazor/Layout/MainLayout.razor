@inherits LayoutComponentBase

<div class="ad-shell">
    <!-- Top Header: White background with logo and user info -->
    <header class="ad-header">
        <div class="ad-header-inner ad-container">
            <a class="ad-brand" href="/">
                <span class="ad-brand-triangle"></span>
                <span class="ad-brand-text"><span class="light">ASHLEY</span>DIRECT</span>
            </a>
            <div class="ad-header-right">
                <div class="ad-user-info">
                    <span class="ad-user-icon">👤</span>
                    <span class="ad-user-name">S Sampanthamoorthy</span>
                </div>
                <div class="ad-workbench">
                    <span class="ad-workbench-icon">🖥️</span>
                    <span class="ad-workbench-label">Workbench</span>
                </div>
            </div>
        </div>
    </header>

    <!-- Orange sub-header with account info -->
    <div class="ad-subheader">
        <div class="ad-container ad-subheader-inner">
            <span class="ad-account-info">4031300 / ALL - RESIDENT HOME, INC</span>
        </div>
    </div>

    <!-- Page title centered -->
    <div class="ad-titlebar">
        <div class="ad-container">
            <h1 class="ad-title">E-Payment</h1>
        </div>
    </div>

    <!-- Navigation links -->
    <div class="ad-container">
        <EpayTopNav />
    </div>

    <main class="ad-container ad-content">
        @Body
    </main>

    <!-- Footer: 3-column layout -->
    <footer class="ad-footer">
        <div class="ad-container ad-footer-grid">
            <section>
                <h6>Get To Know Us</h6>
                <ul>
                    <li><a href="#">The Ashley Story</a></li>
